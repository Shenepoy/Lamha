<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.lamha.Lamha</id>
  <name>Lamha</name>
  <summary>A secure, cross-desktop screenshot tool</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <description>
    <p>Lamha is a GTK4 screenshot tool for Wayland Linux desktops. It uses the XDG Desktop Portal so capture and selection work with GNOME and KDE Plasma.</p>
    <p>It can capture an area, a window, or a screen, delay the shot, annotate with pen, box, highlight, blur, steps, and magic erase, copy the image to the clipboard, and keep a local history.</p>
  </description>
  <developer_name>Shenepoy</developer_name>
  <developer id="io.github.zyzto">
    <name>Shenepoy</name>
  </developer>
  <url type="homepage">https://github.com/Zyzto/Lamha</url>
  <url type="bugtracker">https://github.com/Zyzto/Lamha/issues</url>
  <url type="vcs-browser">https://github.com/Zyzto/Lamha</url>
  <launchable type="desktop-id">io.github.lamha.Lamha.desktop</launchable>
  <provides>
    <binary>lamha</binary>
  </provides>
  <categories>
    <category>Utility</category>
    <category>Graphics</category>
  </categories>
  <custom>
    <value key="X-AppImage-UpdateInformation">gh-releases-zsync|Zyzto|Lamha|latest|Lamha-*x86_64.AppImage.zsync</value>
  </custom>
